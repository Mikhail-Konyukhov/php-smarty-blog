{extends file='layout.tpl'}

{block name=title}{if $code == 404}Страница не найдена{else}Ошибка на сервере{/if}{/block}

{block name=content}
    {if $code == 404}
        <h1>Страница не найдена</h1>
        <p>Такой страницы нет: возможно, ссылка устарела.</p>
    {else}
        <h1>Ошибка на сервере</h1>
        <p>Что-то сломалось. Попробуйте обновить страницу позже.</p>
    {/if}
    <p><a href="/">На главную</a></p>
{/block}
