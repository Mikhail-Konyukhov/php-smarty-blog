{
    "name": "mikhail-konyukhov/php-smarty-blog",
    "description": "Блог на PHP, Smarty и MySQL без фреймворков",
    "type": "project",
    "require": {
        "php": "^8.4",
        "smarty/smarty": "^5.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
